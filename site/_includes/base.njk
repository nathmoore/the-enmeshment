<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "The Enmeshment" }}</title>
  <meta name="description" content="{{ description }}">

  {# Open Graph / Twitter — the share-unfurl card IS the virality engine (MECHANICS §I).
     Each dossier page sets its own title/description so a pasted link previews on-brand.
     og:image and og:url MUST be absolute; `site.url` (_data/site.json) + the `| url`
     filter supplies the origin and the pathPrefix. #}
  <meta property="og:site_name" content="The Enmeshment">
  <meta property="og:title" content="{{ title or 'The Enmeshment' }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  {% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage | url }}">{% endif %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if ogImage else 'summary' }}">

  {# Stylesheet — the dossier reads like a leaked file (monospace, classification-form,
     screenshot-ready). Self-hosted and system-font only: no webfonts, no CDN, no
     analytics, no third-party requests at all. The privacy-respecting profiler
     practises what it preaches (GUARDRAILS §4). #}
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
</head>
<body>
  {# Site-wide nav — every page can get home, to the files list, the scenario and the
     reading room. aria-current marks the page you're on. #}
  <header class="site-nav">
    <a class="brand" href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>The Enmeshment</a>
    <nav aria-label="Site">
      <a href="{{ '/#files' | url }}"{% if page.url.startsWith('/files/') %} aria-current="page"{% endif %}>The files</a>
      <a href="{{ '/scenario/' | url }}"{% if page.url == '/scenario/' %} aria-current="page"{% endif %}>The scenario</a>
      <a href="{{ '/reading-room/' | url }}"{% if page.url == '/reading-room/' %} aria-current="page"{% endif %}>Reading room</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>The Enmeshment — a fiction, and a question about the human–AI relationship we want.
       <a href="https://github.com/nathmoore/the-enmeshment">Open kitchen on GitHub</a>.</p>
  </footer>
</body>
</html>

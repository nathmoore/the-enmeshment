---
layout: base.njk
---
{# Per-archetype dossier layout (chains to base.njk). One template, 11 data files.
   Body = the voiced dossier (ported from src/knowledge/archetype-dossiers.txt, the
   canonical source). `footnote` (front matter) = the declassified footnote: the one
   genuine reflective human–AI question per archetype — level two lives HERE, below
   the fiction, and nowhere in chat. #}
<article class="dossier">
  <header class="letterhead">
    <p class="kicker">ENMESHMENT DIRECTORATE — UNOFFICIAL EXTRACT</p>
    <h1>{{ archetype }}</h1>
    <p class="status">File status: {{ status }}</p>
  </header>

  <div class="file-body">
    {{ content | safe }}
  </div>

  <hr>
  {% if footnote %}
  <aside class="footnote">
    <p class="kicker">DECLASSIFIED FOOTNOTE — below the file</p>
    <p>{{ footnote }}</p>
  </aside>
  {% endif %}
  <p class="disclaimer">This is fiction and play, not a real assessment.</p>

  <nav class="dossier-links">
    <a href="{{ '/scenario/' | url }}">The scenario &rarr;</a>
    <a href="https://github.com/nathmoore/the-enmeshment">Source repo &rarr;</a>
  </nav>
</article>
